NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sika_partners
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# Used only by `npm run seed` — choose your own strong values
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# SMTP (required to approve accounts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
